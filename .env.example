# Clés PUBLIQUES du projet Supabase OFFRYA neuf (jamais le projet NextWeb)
SUPABASE_URL=https://hhxtutvmvlphkutqscad.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_83qJyrux1761NPy7m4HGsQ_5lVCW8fi
PORT=3000
# Uniquement côté SERVEUR, jamais dans HTML, client ou Git
SUPABASE_SECRET_KEY=
UNSUBSCRIBE_SECRET=
# Pour l'envoi facultatif via la tâche planifiée d'alertes
RESEND_API_KEY=
EMAIL_FROM=alertes@votre-domaine.fr
SITE_URL=https://votre-site.example

# Abonnement OFFRYA Premium : désactivé par défaut.
# Supporte Stripe sk_test_, sk_live_, rk_test_ et rk_live_.
# En mode live, vérifier tarif, webhook, CGV, fiscalité et portail avant activation.
OFFRYA_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# SITE_URL et SUPABASE_SECRET_KEY sont requis pour le paiement.

# Optionnel : vérification d'identité externe ; désactivée tant que ces secrets ne sont pas configurés.
# Le secret du webhook Identity est distinct de STRIPE_WEBHOOK_SECRET (Billing).
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Activer la comparaison du selfie uniquement après analyse RGPD / DPIA et information des utilisateurs.
OFFRYA_IDENTITY_SELFIE_ENABLED=false

# Protection recommandée des publications invitées : clé publique de site Cloudflare Turnstile.
# La clé SECRÈTE Turnstile doit être configurée exclusivement dans Supabase Auth -> CAPTCHA,
# pas dans les variables publiques ni dans le navigateur.
OFFRYA_TURNSTILE_SITE_KEY=

# Scrapfly : aperçu ponctuel non activé. Ne PAS stocker la clé dans Git ni le navigateur.
# N'activer que si Leboncoin autorise explicitement l'intermédiaire Scrapfly,
# ses éventuels proxys et le respect des règles robots.txt.
SCRAPFLY_API_KEY=
LEBONCOIN_SCRAPFLY_ENABLED=true
LEBONCOIN_SCRAPFLY_PARTNER_APPROVED=false
LEBONCOIN_SCRAPFLY_ROBOTS_REVIEWED=false
LEBONCOIN_DRY_RUN=true
LEBONCOIN_SEARCH_URLS=[]
# Facultatif : écrire un CSV expurgé et un rapport statistique
LEBONCOIN_VALIDATION_CSV=
LEBONCOIN_VALIDATION_REPORT=

# Diagnostic unique de la connexion Scrapfly au redémarrage du serveur.
# Activer temporairement à true uniquement pour le test approuvé ; remettre à false après résultat.
# Cible exclusivement https://httpbin.dev/html (aucune collecte Leboncoin).
SCRAPFLY_AUTH_TEST_ON_BOOT=true

# Protection globale pour toute consultation Leboncoin, y compris le suivi des retraits.
# Ne modifier qu'après contrôle indépendant des droits et de robots.txt.
LEBONCOIN_COLLECTOR_ENABLED=true
LEBONCOIN_COLLECTION_AUTHORIZED=true
LEBONCOIN_ROBOTS_REVIEWED=false
LEBONCOIN_SYNC_ENABLED=true
LEBONCOIN_DRY_RUN=true
# Quotas fixes en base : 6 accès maximum par exécution, 20/jour, 300/mois,
# >=5 secondes entre accès et >=4 h entre deux exécutions (heure de Paris).
# La clé SUPABASE_SECRET_KEY est utilisée serveur uniquement pour réserver le quota.
