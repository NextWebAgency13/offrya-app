# OFFRYA DCE hardened runtime - opt-in, NOT applied to current Render service.
# Requires >= 4 GiB RAM for ClamAV database reload + PDF/OCR workers.
FROM node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates clamav clamav-daemon clamav-freshclam \
    gosu tini tesseract-ocr tesseract-ocr-fra \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund \
 && npm cache clean --force
COPY . .
COPY deploy/dce/clamd.conf /etc/clamav/clamd-offrya.conf
RUN chmod 0755 /app/deploy/dce/entrypoint.sh \
 && mkdir -p /run/clamav /var/lib/clamav /var/log/clamav \
 && chown -R clamav:clamav /run/clamav /var/lib/clamav /var/log/clamav \
 && usermod -aG clamav node \
 && chown -R node:node /app
ENV NODE_ENV=production \
    PORT=10000 \
    DCE_CLAMD_SOCKET=/run/clamav/clamd.ctl \
    DCE_CLAMDB_DIR=/var/lib/clamav \
    DCE_OCR_ENABLED=true
EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini","--","/app/deploy/dce/entrypoint.sh"]
